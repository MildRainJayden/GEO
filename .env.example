GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-4.1-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M1

# Model weighting for multi-provider scoring.
# Defaults use domestic public MAU-style scale signals where available:
# doubao:qwen:deepseek = 38230:16718:12982.
# Final score uses 70% MAU share + 30% equal model share by default.
AIVC_PROVIDER_MAU_WEIGHTS={"doubao":38230,"qwen":16718,"deepseek":12982,"yuanbao":4984,"kimi":1800,"minimax":2000,"gpt":2000}
AIVC_UNKNOWN_PROVIDER_MAU=2000
AIVC_PROVIDER_MAU_BLEND=0.7

# Add any OpenAI-compatible provider without code changes.
# AIVC_OPENAI_COMPATIBLE_PROVIDERS=[{"name":"my-provider","api_key_env":"MY_PROVIDER_API_KEY","base_url":"https://api.example.com/v1","model":"model-name"}]

DATABASE_URL=postgresql+psycopg://aivc:aivc@postgres:5432/aivc
REDIS_URL=redis://redis:6379/0
